{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build TGWatch",
      "type": "process",
      "command": "dotnet",
      "args": ["build"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run TGWatch",
      "type": "process",
      "command": "dotnet",
      "args": ["run"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish portable EXE",
      "type": "process",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\publish-portable.ps1"],
      "problemMatcher": "$msCompile"
    }
  ]
}
