<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TGWatch</AssemblyName>
    <RootNamespace>TGWatch.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <FileVersion>0.6.0.0</FileVersion>
    <Product>TGWatch for Windows</Product>
    <Authors>IU2VTP</Authors>
    <Description>Lightweight Windows tray monitor for live DMR talkgroup activity.</Description>
    <Copyright>Copyright © 2026 IU2VTP</Copyright>
  </PropertyGroup>

</Project>
