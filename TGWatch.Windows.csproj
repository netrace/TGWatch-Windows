<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TGWatch</AssemblyName>
    <RootNamespace>TGWatch.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TGWatch.ico</ApplicationIcon>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <Product>TGWatch for Windows</Product>
    <Company>IU2VTP</Company>
    <Description>Lightweight DMR talkgroup activity monitor for HamThings and BrandMeister.</Description>
    <Copyright>Copyright © 2026 IU2VTP</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\TGWatch.ico" />
  </ItemGroup>

</Project>
